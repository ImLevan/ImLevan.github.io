---
import { User, Briefcase, MapPin, Send } from "@lucide/astro";
import Github from "../components/icons/Github.astro";
import Linkedin from "../components/icons/Linkedin.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { useTranslations, type Lang } from "../i18n/ui";

const lang = (Astro.currentLocale as Lang) ?? "es";
const t = useTranslations(lang);

const ACCESS_KEY = "99fe2cf2-3dbb-4d7b-834a-319ccd148885";

const info = [
	{ Icon: User, value: "Valentin Chianese" },
	{ Icon: Briefcase, value: t("contact.role") },
	{ Icon: MapPin, value: t("about.location") },
];

const socials = [
	{ href: "https://github.com/ImLevan", label: t("social.github"), Icon: Github },
	{ href: "https://ar.linkedin.com/in/valentin-chianese", label: t("social.linkedin"), Icon: Linkedin },
];

const inputClass =
	"w-full rounded-xl border border-border bg-bg-subtle px-4 py-3 text-sm text-text placeholder:text-text-faint transition-colors focus:border-accent focus:outline-none";
---

<section id="contact" class="scroll-mt-24 py-24 sm:py-32">
	<div class="mx-auto max-w-6xl px-6">
		<SectionLabel index="06" label={t("contact.eyebrow")} />

		<h2
			data-reveal
			class="mt-6 font-display text-3xl font-bold tracking-tight sm:text-4xl"
		>
			{t("contact.title")}
		</h2>
		<p data-reveal class="mt-3 max-w-2xl text-text-muted">
			{t("contact.desc")}
		</p>

		<div class="mt-12 grid gap-8 lg:grid-cols-2">
			<!-- Info -->
			<div data-reveal class="glass flex flex-col justify-between rounded-2xl p-8">
				<div class="space-y-4">
					{
						info.map(({ Icon, value }) => (
							<p class="flex items-center gap-3 text-text-muted">
								<span class="flex size-9 items-center justify-center rounded-full bg-accent/15 text-accent">
									<Icon class="size-4" />
								</span>
								{value}
							</p>
						))
					}
				</div>
				<div class="mt-8 flex items-center gap-2">
					{
						socials.map(({ href, label, Icon }) => (
							<a
								href={href}
								aria-label={label}
								title={label}
								target="_blank"
								rel="noopener noreferrer"
								class="flex size-11 items-center justify-center rounded-full border border-border text-text-muted transition-colors hover:border-accent hover:bg-accent/15 hover:text-accent"
							>
								<Icon class="size-5" />
							</a>
						))
					}
				</div>
			</div>

			<!-- Form -->
			<form
				data-reveal
				id="contact-form"
				class="glass rounded-2xl p-8"
				novalidate
			>
				<input type="hidden" name="access_key" value={ACCESS_KEY} />
				<input type="hidden" name="from_name" value="Portfolio" />

				<div class="grid gap-4 sm:grid-cols-2">
					<input
						name="name"
						type="text"
						required
						autocomplete="name"
						placeholder={t("contact.form.name")}
						class={inputClass}
					/>
					<input
						name="email"
						type="email"
						required
						autocomplete="email"
						placeholder={t("contact.form.email")}
						class={inputClass}
					/>
				</div>
				<input
					name="subject"
					type="text"
					required
					placeholder={t("contact.form.subject")}
					class={`mt-4 ${inputClass}`}
				/>
				<textarea
					name="message"
					required
					rows="5"
					placeholder={t("contact.form.message")}
					class={`mt-4 resize-none ${inputClass}`}></textarea>

				<div
					class="mt-6 flex flex-wrap items-center justify-between gap-4"
				>
					<p
						id="form-status"
						role="status"
						aria-live="polite"
						class="text-sm"
					>
					</p>
					<button
						type="submit"
						class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-accent-contrast transition-transform hover:bg-accent-strong hover:-translate-y-0.5"
					>
						<Send class="size-4" />
						<span class="submit-label">{t("contact.form.submit")}</span>
					</button>
				</div>
			</form>
		</div>
	</div>
</section>

<script define:vars={{ messages: {
	sending: t("contact.form.sending"),
	success: t("contact.form.success"),
	error: t("contact.form.error"),
	submit: t("contact.form.submit"),
} }}>
	const form = document.getElementById("contact-form");
	const status = document.getElementById("form-status");
	const submitLabel = form?.querySelector(".submit-label");

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		const button = form.querySelector('button[type="submit"]');
		if (button) button.disabled = true;
		if (submitLabel) submitLabel.textContent = messages.sending;
		if (status) {
			status.textContent = "";
			status.classList.remove("text-accent", "text-wine-300");
		}

		try {
			const data = new FormData(form);
			const response = await fetch("https://api.web3forms.com/submit", {
				method: "POST",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify(Object.fromEntries(data.entries())),
			});

			const result = await response.json();

			if (response.ok && result.success) {
				if (status) {
					status.textContent = messages.success;
					status.classList.add("text-accent");
				}
				form.reset();
			} else {
				throw new Error(result.message ?? "Error");
			}
		} catch {
			if (status) {
				status.textContent = messages.error;
				status.classList.add("text-wine-300");
			}
		} finally {
			if (button) button.disabled = false;
			if (submitLabel) submitLabel.textContent = messages.submit;
		}
	});
</script>
