---
import SectionLabel from "../components/SectionLabel.astro";
import {
	frontendSkills,
	backendSkills,
	otherSkills,
	type Skill,
} from "../data/skills";
import { useTranslations, type Lang } from "../i18n/ui";

const lang = (Astro.currentLocale as Lang) ?? "es";
const t = useTranslations(lang);

const groups: { title: string; skills: Skill[] }[] = [
	{ title: t("skills.frontend"), skills: frontendSkills },
	{ title: t("skills.backend"), skills: backendSkills },
	{ title: t("skills.other"), skills: otherSkills },
];
---

<section id="skills" class="scroll-mt-24 py-24 sm:py-32">
	<div class="mx-auto max-w-6xl px-6">
		<SectionLabel index="05" label={t("skills.eyebrow")} />

		<h2
			data-reveal
			class="mt-6 font-display text-3xl font-bold tracking-tight sm:text-4xl"
		>
			{t("skills.title")}
		</h2>

		<div class="mt-12 space-y-12">
			{
				groups.map((group) => (
					<div data-reveal>
						<h3 class="text-sm font-semibold tracking-[0.2em] text-text-faint uppercase">
							{group.title}
						</h3>
						<div class="mt-5 flex flex-wrap gap-2.5">
							{group.skills.map((skill) => (
								<div
									class="glass group flex items-center gap-2.5 rounded-xl py-2 pr-4 pl-3 transition-colors hover:border-accent/40"
									title={skill.description[lang]}
								>
									<img
										src={skill.img}
										alt=""
										loading="lazy"
										class="size-7 object-contain transition-transform duration-300 group-hover:scale-110"
									/>
									<div class="leading-tight">
										<span class="block text-sm font-medium">
											{skill.title}
										</span>
										<span class="hidden text-xs text-text-faint sm:block">
											{skill.description[lang]}
										</span>
									</div>
								</div>
							))}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
