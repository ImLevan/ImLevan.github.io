---
import { Heart } from "@lucide/astro";
import { useTranslations, type Lang } from "../i18n/ui";

const lang = (Astro.currentLocale as Lang) ?? "es";
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-border py-10">
	<div
		class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-6 text-sm text-text-faint sm:flex-row"
	>
		<p class="font-display font-semibold text-text-muted">VC © {year}</p>
		<p>{t("footer.rights")}</p>
		<p class="inline-flex items-center gap-1">
			{t("footer.built")}
			<Heart class="size-3.5 fill-accent text-accent" />
			Astro
		</p>
	</div>
</footer>
