---
import { Briefcase, GraduationCap, ArrowUpRight } from "@lucide/astro";
import SectionLabel from "../components/SectionLabel.astro";
import { timeline } from "../data/experience";
import { useTranslations, type Lang } from "../i18n/ui";

const lang = (Astro.currentLocale as Lang) ?? "es";
const t = useTranslations(lang);
---

<section id="experience" class="scroll-mt-24 py-24 sm:py-32">
	<div class="mx-auto max-w-6xl px-6">
		<SectionLabel index="03" label={t("experience.eyebrow")} />

		<h2
			data-reveal
			class="mt-6 font-display text-3xl font-bold tracking-tight sm:text-4xl"
		>
			{t("experience.title")}
		</h2>

		<div class="relative mt-12">
			<!-- Línea del timeline (se dibuja con GSAP en fase 4) -->
			<div
				data-timeline-line
				class="absolute top-2 bottom-2 left-[19px] w-px bg-gradient-to-b from-accent via-border to-transparent sm:left-[23px]"
				aria-hidden="true"
			>
			</div>

			<ol class="space-y-8">
				{
					timeline.map((item) => {
						const isWork = item.kind === "work";
						const Icon = isWork ? Briefcase : GraduationCap;
						return (
							<li data-reveal class="relative flex gap-5 sm:gap-7">
								<!-- Icono del hito -->
								<div class="relative z-10 flex size-10 shrink-0 items-center justify-center rounded-full border border-border bg-bg text-accent sm:size-12">
									<Icon class="size-4 sm:size-5" />
								</div>

								<div class="glass flex-1 rounded-2xl p-5 transition-colors hover:border-accent/40 sm:p-6">
									<div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
										<span
											class:list={[
												"rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider",
												isWork
													? "bg-accent/15 text-accent"
													: "bg-surface text-text-muted",
											]}
										>
											{isWork
												? t("experience.workLabel")
												: t("experience.eduLabel")}
										</span>
										<time class="text-xs text-text-faint">{item.date[lang]}</time>
									</div>

									<h3 class="mt-3 font-display text-lg font-semibold sm:text-xl">
										{item.title[lang]}
									</h3>
									<p class="mt-0.5 text-sm font-medium text-accent">
										{item.organization[lang]}
									</p>
									<p class="mt-3 text-sm leading-relaxed text-text-muted">
										{item.description[lang]}
									</p>

									{item.highlights && (
										<ul class="mt-4 flex flex-wrap gap-2">
											{item.highlights.map((h) => (
												<li class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">
													{h[lang]}
												</li>
											))}
										</ul>
									)}

									{item.link && (
										<a
											href={item.link.href}
											target="_blank"
											rel="noopener noreferrer"
											class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-text-muted transition-colors hover:text-accent"
										>
											{item.link.label[lang]}
											<ArrowUpRight class="size-4" />
										</a>
									)}
								</div>
							</li>
						);
					})
				}
			</ol>
		</div>
	</div>
</section>
