---
import { ArrowDown, Mail } from "@lucide/astro";
import Github from "../components/icons/Github.astro";
import Linkedin from "../components/icons/Linkedin.astro";
import { typingWords, useTranslations, type Lang } from "../i18n/ui";

const lang = (Astro.currentLocale as Lang) ?? "es";
const t = useTranslations(lang);

const socials = [
	{ href: "https://github.com/ImLevan", label: t("social.github"), Icon: Github },
	{ href: "https://ar.linkedin.com/in/valentin-chianese", label: t("social.linkedin"), Icon: Linkedin },
	{ href: "mailto:chianesevalentin@gmail.com", label: t("social.mail"), Icon: Mail },
];
---

<section id="top" class="relative flex min-h-screen items-center">
	<div class="mx-auto w-full max-w-6xl px-6 pt-28 pb-24">
		<p
			class="glass mb-6 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm text-text-muted"
		>
			<span class="relative flex size-2">
				<span
					class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
				></span>
				<span class="relative inline-flex size-2 rounded-full bg-accent"></span>
			</span>
			{t("hero.badge")}
		</p>

		<h1
			class="font-display text-[clamp(2.75rem,7vw,5.5rem)] leading-[1.05] font-bold tracking-tight text-balance"
		>
			{t("hero.greeting")} <span class="text-accent">Valentin</span> Chianese
		</h1>

		<div
			class="mt-6 min-h-8 sm:min-h-12"
			aria-live="polite"
		>
			<h2
				class="font-display text-lg font-medium whitespace-nowrap text-text-muted sm:text-3xl"
			>
				<span
					id="typing-span"
					data-words={JSON.stringify(typingWords[lang])}
				></span><span
					class="typing-cursor ml-0.5 font-light text-accent">|</span
				>
			</h2>
		</div>

		<div class="mt-10 flex flex-wrap items-center gap-3">
			<a
				href="#projects"
				data-magnetic
				class="rounded-full bg-accent-strong px-6 py-3 text-sm font-semibold text-accent-contrast transition-all hover:brightness-110 hover:-translate-y-0.5"
			>
				{t("nav.projects")}
			</a>
			<a
				href="#contact"
				data-magnetic
				class="glass rounded-full px-6 py-3 text-sm font-semibold text-text transition-colors hover:border-accent/50 hover:text-accent"
			>
				{t("nav.contact")}
			</a>
		</div>

		<div class="mt-12 flex items-center gap-1">
			{
				socials.map(({ href, label, Icon }) => (
					<a
						href={href}
						aria-label={label}
						title={label}
						target={href.startsWith("http") ? "_blank" : undefined}
						rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
						class="flex size-10 items-center justify-center rounded-full text-text-muted transition-colors hover:bg-surface hover:text-accent"
					>
						<Icon class="size-5" />
					</a>
				))
			}
		</div>
	</div>

	<a
		href="#about"
		aria-label={t("a11y.scrollDown")}
		class="absolute bottom-8 left-1/2 -translate-x-1/2 text-text-faint transition-colors hover:text-accent"
	>
		<ArrowDown class="size-6 animate-bounce" />
	</a>
</section>

<style>
	.typing-cursor {
		animation: blink 0.7s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
</style>

<script>
	const span = document.getElementById("typing-span");

	if (span) {
		const words: string[] = JSON.parse(span.dataset.words ?? "[]");
		let currentWordIndex = 0;
		let isDeleting = false;
		let charIndex = 0;

		function typeNextWord() {
			const currentWord = words[currentWordIndex];
			if (!currentWord) return;

			const currentText = isDeleting
				? currentWord.substring(0, charIndex - 1)
				: currentWord.substring(0, charIndex + 1);

			charIndex += isDeleting ? -1 : 1;
			span.textContent = currentText;

			const deleteSpeed = isDeleting ? 20 : 80;

			if (!isDeleting && currentText === currentWord) {
				isDeleting = true;
				setTimeout(typeNextWord, 1500);
			} else if (isDeleting && currentText === "") {
				isDeleting = false;
				currentWordIndex = (currentWordIndex + 1) % words.length;
				setTimeout(typeNextWord, 500);
			} else {
				setTimeout(typeNextWord, isDeleting ? deleteSpeed : 100);
			}
		}

		typeNextWord();
	}
</script>
