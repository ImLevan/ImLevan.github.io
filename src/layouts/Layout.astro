---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	lang?: "es" | "en";
}

const {
	title,
	description = "Valentin Chianese, Técnico Universitario en Informática y Desarrollador de software con experiencia en la creación de aplicaciones web y de escritorio. Mí portafolio presenta una variedad de proyectos, desde aplicaciones simples hasta proyectos complejos.",
	lang = "es",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://imlevan.github.io/");
const pageUrl = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical + hreflang -->
		<link rel="canonical" href={pageUrl} />
		<link rel="alternate" hreflang="es" href={new URL("/", siteUrl)} />
		<link rel="alternate" hreflang="en" href={new URL("/en", siteUrl)} />
		<link rel="alternate" hreflang="x-default" href={new URL("/", siteUrl)} />

		<!-- Open Graph -->
		<meta property="og:url" content={pageUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL("img/logo/logoVC.jpg", siteUrl)} />
		<meta property="og:locale" content={lang === "en" ? "en_US" : "es_AR"} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL("img/logo/logoVC.jpg", siteUrl)} />

		<!-- Favicon -->
		<link rel="icon" href="/img/logo/logoVC.jpg" />

		<!-- Theme init (antes del paint para evitar FOUC) -->
		<script is:inline>
			(() => {
				const stored = localStorage.getItem("theme");
				const prefersLight = window.matchMedia(
					"(prefers-color-scheme: light)",
				).matches;
				if (stored === "light" || (!stored && prefersLight)) {
					document.documentElement.classList.add("light");
				}
			})();
		</script>

		<title>{title}</title>
	</head>
	<body>
		<slot />
		<div class="noise-overlay" aria-hidden="true"></div>
	</body>
</html>
