---
interface Props {
	index: string;
	label: string;
	class?: string;
}

const { index, label, class: className } = Astro.props;
---

<div
	class:list={[
		"flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-accent",
		className,
	]}
>
	<span>{index}</span>
	<span class="h-px w-10 bg-accent/40" aria-hidden="true"></span>
	<span>{label}</span>
</div>
